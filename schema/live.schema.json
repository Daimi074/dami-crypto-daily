{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "updatedAt",
    "prices",
    "candles",
    "fearGreed",
    "funding",
    "oi",
    "longShort",
    "deriv",
    "errors"
  ],
  "properties": {
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "prices": {
      "type": [
        "null",
        "array"
      ],
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sym",
          "price",
          "high",
          "low",
          "asOf",
          "src"
        ],
        "properties": {
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "asOf": {
            "format": "date-time"
          }
        }
      }
    },
    "candles": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "lastOpen",
        "src",
        "t",
        "o",
        "h",
        "l",
        "c",
        "v"
      ],
      "properties": {
        "t": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "o": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "h": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "l": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "c": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "v": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "fearGreed": {
      "type": [
        "object",
        "null"
      ]
    },
    "funding": {
      "type": [
        "object",
        "null"
      ]
    },
    "oi": {
      "type": [
        "object",
        "null"
      ]
    },
    "longShort": {
      "type": [
        "object",
        "null"
      ]
    },
    "deriv": {
      "type": [
        "object",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

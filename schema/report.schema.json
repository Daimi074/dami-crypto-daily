        "dataQuality": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "status",
              "note"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "stale",
                  "missing",
                  "partial"
                ]
              }
            }
          }
        },
        "correction": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "previous",

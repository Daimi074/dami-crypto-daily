{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "date",
    "kind",
    "title",
    "headline",
    "markdown",
    "updatedAt",
    "sortKey",
    "metrics"
  ],
  "properties": {
    "date": {
      "format": "date",
      "type": "string"
    },
    "kind": {
      "enum": [
        "morning",
        "evening"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "\\+08:00$"
    },
    "sortKey": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[12]$"
    },
    "metrics": {
      "type": "object",
      "required": [
        "trend",
        "stance",
        "action",
        "qqqSwitch",
        "dataQuality"
      ],
      "properties": {
        "trend": {
          "enum": [
            null,
            "多頭趨勢",
            "空頭趨勢",
            "盤整"
          ]
        },
        "stance": {
          "enum": [
            null,
            "偏多",
            "偏空",
            "觀望",
            "減碼"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "qqqSwitch": {
          "enum": [
            null,
            "開",
            "關"
          ]
        },
        "fearGreed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "longShort": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "btc": {
              "type": [
                "number",
                "null"
              ]
            },
            "eth": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "yields": {
          "type": [
            "object",
            "null"
          ]
        },
        "etf": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "btc": {
              "type": [
                "number",
                "null"
              ]
            },
            "eth": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "funding": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "btc": {
              "type": [
                "number",

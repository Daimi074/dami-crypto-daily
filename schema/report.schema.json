          }
        },
        "events": {
          "type": "array"
        },
        "cryptoStocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sym"
            ],
            "properties": {
              "sym": {
                "type": "string"
              },
              "chg": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "causal": {
          "type": "array"
        },
        "prices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sym",
              "price"
            ],
            "properties": {
              "price": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "chg24h": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "side",
              "entry",
              "stop",
              "t1",
              "t2",
              "rr1",
              "rr2",
              "halfSize",
              "trigger",
              "invalid",
              "liqPrice",
              "pnlStop",
              "pnlT1",
              "pnlT2"
